{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/OakButton/**",
              "components/OakIcon/**",
              "components/OakSubjectChip/**",
              "components/OakTag/**",
              "integrations/revealjs/vendor/**",
              "oak-theme.js",
              "preview/**",
              "ui_kits/oak/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lexend|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Lexend, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OakButton> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|inverted)$/]",
        "message": "<OakButton> variant must be one of 'primary' | 'secondary' | 'inverted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<OakButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|invert|alt|style|key|ref|className|style|children)$/]",
        "message": "<OakIcon> doesn't accept that prop. Declared props: name, size, invert, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakSubjectChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:subject|size|icon|bg|style|key|ref|className|style|children)$/]",
        "message": "<OakSubjectChip> doesn't accept that prop. Declared props: subject, size, icon, bg, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|icon|trailingIcon|style|key|ref|className|style|children)$/]",
        "message": "<OakTag> doesn't accept that prop. Declared props: children, color, icon, trailingIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OakTag'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:lemon|mint|aqua|lavender|pink|grey|white)$/]",
        "message": "<OakTag> color must be one of 'lemon' | 'mint' | 'aqua' | 'lavender' | 'pink' | 'grey' | 'white'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "OakButton": {
        "replaces": []
      },
      "OakIcon": {
        "replaces": []
      },
      "OakSubjectChip": {
