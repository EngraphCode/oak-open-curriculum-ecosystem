{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  // The store types a browser collaborator (Window.oakTheme); the base
  // config's lib is ES2023-only. Same precedent as
  // oak-design-system/tsconfig.json.
  "compilerOptions": { "lib": ["ES2023", "DOM"] },
  "include": ["src/**/*.ts", "**/*.test.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
