{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The landing page is server-rendered React (`react-dom/server`), so the
    // app's own source now carries .tsx alongside the widget's.
    "jsx": "react-jsx"
  },
  "include": [
    // No bare `**/*.test.ts`: the directory globs above already cover their
    // own tests, and an unscoped glob reaches into widget/, whose tests are
    // checked by widget/tsconfig.json (its own DOM-bearing project) — dual
    // membership type-checks them once WITHOUT lib.dom.
    "operations/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "build-scripts/**/*.ts",
    "runtime-only-scripts/**/*.d.mts",
    "e2e-tests/**/*.ts",
    "*.config.ts",
    "vitest.e2e.config.ts",
    "bin/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "temp-secrets", "../../.agent/reference/**"]
}
