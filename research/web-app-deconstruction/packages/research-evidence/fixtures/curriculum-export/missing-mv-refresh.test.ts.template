/**
 * @jest-environment node
 */
import handler from "__OWA_HANDLER_IMPORT__";
import { createNextApiMocks } from "__OWA_MOCKS_IMPORT__";

jest.mock("@/node-lib/curriculum-api-2023", () => ({
  __esModule: true,
  default: {
    refreshedMVTime: jest.fn(async () => ({ data: [] })),
  },
}));

jest.mock("@/common-lib/error-reporter", () => ({
  __esModule: true,
  default: () => jest.fn(),
}));

const query = (mvRefreshTime: string) => ({
  types: ["curriculum-plans"],
  mvRefreshTime,
  subjectSlug: "english",
  phaseSlug: "secondary",
  state: "published",
  ks4OptionSlug: "aqa",
});

it("redirects again when missing MV metadata produces a new timestamp", async () => {
  jest.spyOn(Date, "now").mockReturnValueOnce(1000).mockReturnValueOnce(1001);

  const first = createNextApiMocks({ query: query("0") });
  await handler(first.req, first.res);
  expect(first.res._getStatusCode()).toBe(307);
  expect(first.res._getRedirectUrl()).toContain("mvRefreshTime=1000");

  const second = createNextApiMocks({ query: query("1000") });
  await handler(second.req, second.res);
  expect(second.res._getStatusCode()).toBe(307);
  expect(second.res._getRedirectUrl()).toContain("mvRefreshTime=1001");
});
