{
  "name": "@oaknational/web-app-deconstruction",
  "version": "0.1.0",
  "private": true,
  "description": "A turbo pnpm monorepo for research, experimentation, recording and sharing on the theme of 'what makes a web app', with a particular focus on what makes an Oak web app",
  "author": "Oak National Academy",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm research:check && pnpm research:evidence:test",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "research:check": "tsx packages/research-evidence/scripts/check-research.ts",
    "research:evidence:test": "pnpm --filter @oaknational/research-evidence test",
    "research:inventory": "pnpm --filter @oaknational/research-evidence inventory",
    "research:owa-architecture": "pnpm --filter @oaknational/research-evidence inventory:owa-architecture",
    "research:oce": "pnpm --filter @oaknational/research-evidence inventory:oce",
    "research:database-api-chain": "pnpm --filter @oaknational/research-evidence inventory:database-api-chain",
    "research:openapi-oce": "pnpm --filter @oaknational/research-evidence compare:openapi-oce",
    "research:components": "pnpm --filter @oaknational/research-evidence runtime",
    "research:concept-links": "pnpm --filter @oaknational/research-evidence validate:concept-links",
    "research:curriculum-redirect": "pnpm --filter @oaknational/research-evidence curriculum-redirect",
    "clean": "turbo run clean && rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "tsx": "^4.22.4",
    "turbo": "^2.10.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  }
}
