#!/usr/bin/env sh

# Disable turbo TUI
export TURBO_UI=0


echo "🚀 Running pre-push checks..."

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks is not installed."
  echo "Install it before running pre-push:"
  echo "  - macOS: brew install gitleaks"
  echo "  - Go: go install github.com/gitleaks/gitleaks/v8@latest"
  echo "Then retry your push."
  exit 1
fi

echo "🛡️ Running secret scan (pushed commits only; CI scans full history)..."
# git feeds pre-push "<local_ref> <local_sha> <remote_ref> <remote_sha>" lines on
# stdin. Scan ONLY the commits being pushed — the CI secret-scan job runs the full
# `--branches --tags` scan (fetch-depth 0) as the comprehensive backstop, so no
# history goes unscanned; it is just not re-scanned across the whole repo on every
# local push (that re-scan grew to minutes as large blobs accumulated in history).
ZERO=0000000000000000000000000000000000000000
scan_range() {
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.renameLimit GIT_CONFIG_VALUE_0=3000 \
    gitleaks detect --redact=100 --source . --log-opts="$1" </dev/null
}
secret_scan_failed=0
secret_scanned_any=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # deleting a ref — nothing to scan
  if [ "$remote_sha" = "$ZERO" ]; then
    scan_opts="$local_sha --not --remotes"        # new branch — commits not yet on any remote
  else
    scan_opts="$remote_sha..$local_sha"           # branch update — only the new commits
  fi
  secret_scanned_any=1
  scan_range "$scan_opts" || secret_scan_failed=1
done
# Fallback when stdin carries no ref lines (manual hook run / unusual invocation).
if [ "$secret_scanned_any" -eq 0 ]; then
  scan_range "HEAD --not --remotes" || secret_scan_failed=1
fi
if [ "$secret_scan_failed" -ne 0 ]; then
  echo "❌ Secret scan failed."
  echo "Remove or scrub secret-like values before pushing."
  echo "Use local placeholders for .env.example and real credentials only in .env files."
  exit 1
fi

echo "📝 Checking formatting..."
if ! pnpm format-check:root; then
  echo "❌ Formatting issues found!"
  echo "💡 Run 'pnpm format:root' to fix formatting issues, then commit the changes"
  exit 1
fi

echo "🔍 Running full markdownlint..."
if ! pnpm markdownlint-check:root; then
  echo "❌ Markdownlint issues found!"
  echo "💡 Run 'pnpm markdownlint:root' to fix markdown issues, then commit again"
  exit 1
fi

echo "🔧 Validating sub-agents..."
if ! pnpm subagents:check; then
  echo "❌ Sub-agent validation failed!"
  exit 1
fi

echo "🔧 Validating portability..."
if ! pnpm portability:check; then
  echo "❌ Portability validation failed!"
  exit 1
fi

echo "🔬 Running knip (unused code detection)..."
if ! pnpm knip; then
  echo "❌ Knip found unused code, exports, or dependencies!"
  echo "💡 Run 'pnpm knip' to see details, then fix or remove unused items"
  exit 1
fi

echo "🔗 Running depcruise (circular deps, orphans, layer violations)..."
if ! pnpm depcruise; then
  echo "❌ Dependency-cruiser found violations!"
  echo "💡 Run 'pnpm depcruise' to see details, then fix circular dependencies or orphan modules"
  exit 1
fi

echo "🧪 Running workspace-owned repo validators..."
if ! pnpm repo-validators:check; then
  echo "❌ Repo validator checks failed!"
  exit 1
fi

echo "🐚 Linting shell scripts..."
if ! pnpm lint:shell; then
  echo "❌ Shell script lint failed!"
  exit 1
fi

# Advisory only — warns when the committed OpenAPI schema cache is stale versus
# upstream. Never blocks the push (the check always exits 0; `|| true` is
# belt-and-braces so a network blip or future change cannot fail pre-push).
echo "🔭 Checking schema cache staleness (advisory, non-blocking)..."
pnpm --filter @oaknational/agent-tools ci-schema-drift-check || true

echo "🔤 Running build, type-check, lint, and tests..."
if ! pnpm turbo run --continue sdk-codegen build type-check lint test test:e2e test:ui; then
  echo "❌ Turbo quality gate checks failed!"
  exit 1
fi

echo "🔤 Scanning file encoding (builds agent-tools, then runs the built scanner)..."
if ! pnpm encoding:check; then
  echo "❌ Encoding scan found a critical finding (invalid UTF-8, BOM, bidi/control byte, or U+FFFD)!"
  exit 1
fi

echo "✅ Pre-push checks completed!"
