# --- Discovery plane: Elasticsearch Serverless (read credentials) ---
# The live instance that also powers curriculum-mcp-alpha. Variable names match
# the repo convention (turbo globalPassThroughEnv) so the demo reads the same
# credentials as the rest of the ecosystem.
ELASTICSEARCH_URL=https://your-deployment.es.region.elastic.cloud
ELASTICSEARCH_API_KEY=

# primary | sandbox — point the demo at sandbox first.
SEARCH_INDEX_TARGET=sandbox
# Optional: pin an index version. Omit to read the live version from oak_meta.
SEARCH_INDEX_VERSION=

# --- Content plane: Oak Open Curriculum REST API ---
# Request a free key: https://open-api.thenational.academy/docs/about-oaks-api/api-keys
OAK_API_KEY=

# Optional: absolute base URL the lesson page uses for its own server-side fetch.
NEXT_PUBLIC_BASE_URL=http://localhost:3010
